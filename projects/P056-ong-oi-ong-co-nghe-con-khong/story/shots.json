  {
   "id": "s09",
   "start": 49.688,
   "end": 58.913,
   "line": "Lời mình cầu cho người đã khuất có thể giúp họ đang được thanh luyện. Và Giáo lý nói, lời cầu ấy còn làm cho lời họ chuyển cầu cho mình thêm hữu hiệu.",
   "scene": "fact",
   "set": "",
